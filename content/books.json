  {"id":"Bar","name":"Baruch","chapters":6,"testament":"OT","beyond":{"canons":["catholic","orthodox","ethiopian","anglican"],"text":"web","note":"Chapter 6 is the Letter of Jeremiah, which Greek Bibles print as a book of its own."}},
  {"id":"DanGr","name":"Daniel (Greek)","chapters":14,"testament":"OT","beyond":{"canons":["catholic","orthodox","anglican"],"text":"web","note":"Daniel with what the Greek adds: the Prayer of Azariah and the Song of the Three Young Men (3:24–90), Susanna (chapter 13) and Bel and the Dragon (chapter 14). From 3:24 to the end of chapter 3 its verse numbers run 67 ahead of the Hebrew's."}},
  {"id":"1Macc","name":"1 Maccabees","chapters":16,"testament":"OT","beyond":{"canons":["catholic","orthodox","anglican"],"text":"web","note":"Not the Ethiopian church's books of Meqabyan, which are different works."}},
