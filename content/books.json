  {"id":"1Esd","name":"1 Esdras","chapters":9,"testament":"OT","beyond":{"canons":["orthodox","ethiopian","anglican"],"text":"web","note":"The Greek Esdras A, called 3 Esdras in the Latin Vulgate. Orthodox Bibles include it in some editions."}},
